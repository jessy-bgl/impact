{
  "cli": {
    "version": ">= 8.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "POSTHOG_CLI_HOST": "https://eu.posthog.com" }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "android": { "image": "latest" },
      "env": { "POSTHOG_CLI_HOST": "https://eu.posthog.com" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "beta" },
      "ios": {
        "ascAppId": "6803395064",
        "appleTeamId": "49T943JS4Y"
      }
    }
  }
}
